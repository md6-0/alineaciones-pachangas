rules_version = '2';
// Reglas de Cloud Firestore para Mi pachanga.
// - Cualquiera con el enlace puede leerlo todo, salvo los pagos (solo quien organiza).
// - Solo quien organiza (su UID) puede escribir.
// Cambia PON_AQUI_TU_UID por tu UID (Authentication → Usuarios) y pégalas en Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function esQuienOrganiza() {
      return request.auth != null && request.auth.uid == "PON_AQUI_TU_UID";
    }
    match /players/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /next/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /signups/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    // Pagos: privados, solo quien organiza los lee y los cambia
    match /payments/{id} {
      allow read, write: if esQuienOrganiza();
    }
  }
}
