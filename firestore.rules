rules_version = '2';
// Reglas de Cloud Firestore para Mi pachanga.
// - Cualquiera con el enlace puede leerlo todo.
// - Quien organiza (su UID) puede escribirlo todo.
// - Los demás entran sin darse cuenta con un usuario anónimo y solo pueden apuntarse a sí mismos
//   a la lista del próximo partido (signups) y borrar lo que apuntaron ellos.
// Cambia PON_AQUI_TU_UID por tu UID (Authentication → Usuarios) y pégalas en Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function esQuienOrganiza() {
      return request.auth != null && request.auth.uid == "PON_AQUI_TU_UID";
    }
    match /players/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /next/{id} {
      allow read: if true;
      allow write: if esQuienOrganiza();
    }
    match /signups/{playerId} {
      allow read: if true;
      // Apuntarse: solo a un jugador que existe, solo una vez, y con su propio uid
      allow create: if esQuienOrganiza() || (request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["at", "uid"])
        && exists(/databases/$(database)/documents/players/$(playerId)));
      allow update: if esQuienOrganiza();
      allow delete: if esQuienOrganiza() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
